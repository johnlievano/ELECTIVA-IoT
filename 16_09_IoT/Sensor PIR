void setup() {
  pinMode(2, OUTPUT);
  pinMode(16, OUTPUT);
  pinMode(3, OUTPUT);
  pinMode(12, INPUT);
}

void loop() {
  int readi = digitalRead(12);
  if (readi==1){
    digitalWrite(2,1);
    digitalWrite(16,1);
    digitalWrite(3,1);
  }else{
    digitalWrite(2,0);
    digitalWrite(16,0);
    digitalWrite(3,0);
  }
}

